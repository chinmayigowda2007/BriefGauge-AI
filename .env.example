# BriefGauge AI - Environment Configuration Example
# Copy this file to .env.local and populate with your credentials.

# Tavily Search API Key (Used to gather recent company developments)
TAVILY_API_KEY=your_tavily_api_key_here

# Bifrost OpenAI-compatible Proxy Configuration
# Bifrost acts as the unified gateway to the model provider
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_VIRTUAL_KEY=your_bifrost_virtual_key_here
BIFROST_MODEL=groq/openai/gpt-oss-20b

# Backend Server Port (defaults to 3001)
PORT=3001
